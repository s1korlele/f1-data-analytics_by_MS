            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[using System;
using System.IO;
using System.Linq;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_cc9b202ca86a45bfba035d496c391c5b
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain :
        Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            try
            {
                // Parametry projektu i paczki
                string projectRoot =
                    Dts.Variables["$Project::ProjectRoot"]
                        .Value
                        .ToString();

                string sourceFolder =
                    Dts.Variables["$Package::SourceFolder"]
                        .Value
                        .ToString();

                string filePattern =
                    Dts.Variables["$Package::FilePattern"]
                        .Value
                        .ToString();

                // Pełna ścieżka do katalogu źródłowego
                string fullFolderPath =
                    Path.Combine(projectRoot, sourceFolder);

                // 1. Sprawdzenie, czy katalog istnieje
                if (!Directory.Exists(fullFolderPath))
                {
                    throw new Exception(
                        "Source folder does not exist: " +
                        fullFolderPath
                    );
                }

                // 2. Pobranie plików zgodnych z patternem
                string[] files =
                    Directory.GetFiles(
                        fullFolderPath,
                        filePattern
                    );

                // 3. Musi istnieć przynajmniej jeden plik
                if (files.Length == 0)
                {
                    throw new Exception(
                        "No source files found. " +
                        "Folder: " + fullFolderPath +
                        ", Pattern: " + filePattern
                    );
                }

                // 4. Każdy plik musi zawierać
                //    przynajmniej jeden wiersz danych
                //    poza nagłówkiem CSV
                foreach (string file in files)
                {
                    bool containsDataRow =
                        File.ReadLines(file)
                            .Skip(1)
                            .Any(
                                line =>
                                    !string.IsNullOrWhiteSpace(line)
                            );

                    if (!containsDataRow)
                    {
                        throw new Exception(
                            "Source file contains no data rows: " +
                            file
                        );
                    }
                }

                // Informacja do logów SSIS
                bool fireAgain = false;

                Dts.Events.FireInformation(
                    0,
                    "Validate Source Files",
                    "Validation succeeded. " +
                    "Folder: " + fullFolderPath +
                    ", Pattern: " + filePattern +
                    ", Files found: " + files.Length,
                    string.Empty,
                    0,
                    ref fireAgain
                );

                Dts.TaskResult =
                    (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                // Błąd powoduje Failure Script Taska
                Dts.Events.FireError(
                    0,
                    "Validate Source Files",
                    ex.Message,
                    string.Empty,
                    0
                );

                Dts.TaskResult =
                    (int)ScriptResults.Failure;
            }
        }

        enum ScriptResults
        {
            Success =
                Microsoft.SqlServer.Dts.Runtime
                    .DTSExecResult.Success,

            Failure =
                Microsoft.SqlServer.Dts.Runtime
                    .DTSExecResult.Failure
        };
    }
}]]></ProjectItem>
