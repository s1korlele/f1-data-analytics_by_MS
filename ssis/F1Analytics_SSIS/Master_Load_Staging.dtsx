          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{93B3489E-C53F-499F-8DD9-DCE8351CDBC8}"
              SQLTask:SqlStatementSource="DECLARE @TargetSchema SYSNAME = ?;&#xA;DECLARE @TargetTable SYSNAME = ?;&#xA;DECLARE @TaskRunKey BIGINT = ?;&#xA;DECLARE @RowsInserted BIGINT;&#xA;DECLARE @Sql NVARCHAR(MAX);&#xA;&#xA;SET @Sql =&#xA;    N'SELECT @RowCount = COUNT_BIG(*) FROM '&#xA;    + QUOTENAME(@TargetSchema)&#xA;    + N'.'&#xA;    + QUOTENAME(@TargetTable)&#xA;    + N';';&#xA;&#xA;EXEC sys.sp_executesql&#xA;    @Sql,&#xA;    N'@RowCount BIGINT OUTPUT',&#xA;    @RowCount = @RowsInserted OUTPUT;&#xA;&#xA;UPDATE etl.TaskRun&#xA;SET&#xA;    Status = 'SUCCEEDED',&#xA;    FinishedAtUtc = SYSUTCDATETIME(),&#xA;    RowsRead = @RowsInserted,&#xA;    RowsInserted = @RowsInserted&#xA;WHERE TaskRunKey = @TaskRunKey;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::TargetSchema"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
