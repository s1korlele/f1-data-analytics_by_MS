              SQLTask:SqlStatementSource="INSERT INTO etl.TaskRun (&#xA;    PackageRunKey,&#xA;    LoadConfigKey,&#xA;    TaskName,&#xA;    TaskType,&#xA;    Status,&#xA;    SourceName,&#xA;    TargetName&#xA;)&#xA;VALUES (&#xA;    ?,&#xA;    ?,&#xA;    CONCAT('Load ', ?),&#xA;    'CSV_LOAD',&#xA;    'RUNNING',&#xA;    CONCAT(?, '\', ?),&#xA;    CONCAT(?, '.', ?)&#xA;);&#xA;&#xA;SELECT CAST(SCOPE_IDENTITY() AS BIGINT) AS TaskRunKey;"
