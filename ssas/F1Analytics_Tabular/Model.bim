                ")"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Average Lap Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Fastest Lap Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Slowest Lap Time",
            "expression": [
              "",
              "MAX(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Average Lap Time Excl Pit Out",
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE('dw FactLap'[LapDurationSeconds]),",
              "    'dw FactLap'[IsPitOutLap] = FALSE()",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Timed Lap Count",
            "expression": [
              "",
              "COUNT(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Lap Records",
            "expression": [
              "",
              "COUNTROWS(",
              "    'dw FactLap'",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Max Lap Number",
            "expression": [
              "",
              "MAX(",
              "    'dw FactLap'[LapNumber]",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Pit Out Lap Count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('dw FactLap'),",
              "    'dw FactLap'[IsPitOutLap] = TRUE()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Average Sector 1 Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[Sector1DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Average Sector 2 Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[Sector2DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Average Sector 3 Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[Sector3DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Fastest Sector 1 Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[Sector1DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Fastest Sector 2 Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[Sector2DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Fastest Sector 3 Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[Sector3DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Average I1 Speed",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[I1Speed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Average I2 Speed",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[I2Speed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Average Speed Trap",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[STSpeed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Max Speed Trap",
            "expression": [
              "",
              "MAX(",
              "    'dw FactLap'[STSpeed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Lap Time Std Dev",
            "expression": [
              "",
              "CALCULATE(",
              "    STDEV.S(",
              "        'dw FactLap'[LapDurationSeconds]",
              "    ),",
              "    'dw FactLap'[IsPitOutLap] = FALSE()",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Consistency"
          }
        ]
      }
