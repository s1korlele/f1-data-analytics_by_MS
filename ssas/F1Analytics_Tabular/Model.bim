        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/MARCIN\\F1DEV;F1Analytics\",",
                "    dw_FactWeather = Source{[Schema=\"dw\",Item=\"FactWeather\"]}[Data]",
                "in",
                "    dw_FactWeather"
              ]
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "_Placeholder",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[_Placeholder]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"_Placeholder\",",
                "    STRING,",
                "    {",
                "        { \"Measures\" }",
                "    }",
                ")"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Average Lap Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Fastest Lap Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Slowest Lap Time",
            "expression": [
              "",
              "MAX(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Average Lap Time Excl Pit Out",
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE('dw FactLap'[LapDurationSeconds]),",
              "    'dw FactLap'[IsPitOutLap] = FALSE()",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Timed Lap Count",
            "expression": [
              "",
              "COUNT(",
              "    'dw FactLap'[LapDurationSeconds]",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Lap Records",
            "expression": [
              "",
              "COUNTROWS(",
              "    'dw FactLap'",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Max Lap Number",
            "expression": [
              "",
              "MAX(",
              "    'dw FactLap'[LapNumber]",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Pit Out Lap Count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('dw FactLap'),",
              "    'dw FactLap'[IsPitOutLap] = TRUE()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Laps\\Counts"
          },
          {
            "name": "Average Sector 1 Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[Sector1DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Average Sector 2 Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[Sector2DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Average Sector 3 Time",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[Sector3DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Fastest Sector 1 Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[Sector1DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Fastest Sector 2 Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[Sector2DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Fastest Sector 3 Time",
            "expression": [
              "",
              "MIN(",
              "    'dw FactLap'[Sector3DurationSeconds]",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Sectors"
          },
          {
            "name": "Average I1 Speed",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[I1Speed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Average I2 Speed",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[I2Speed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Average Speed Trap",
            "expression": [
              "",
              "AVERAGE(",
              "    'dw FactLap'[STSpeed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Max Speed Trap",
            "expression": [
              "",
              "MAX(",
              "    'dw FactLap'[STSpeed]",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Laps\\Speed"
          },
          {
            "name": "Lap Time Std Dev",
            "expression": [
              "",
              "CALCULATE(",
              "    STDEV.S(",
              "        'dw FactLap'[LapDurationSeconds]",
              "    ),",
              "    'dw FactLap'[IsPitOutLap] = FALSE()",
              ")"
            ],
            "formatString": "0.000",
            "displayFolder": "Laps\\Consistency"
          },
          {
            "name": "Official Session Result",
            "expression": [
              "",
              "VAR _HasResult =",
              "    COUNTROWS('dw FactSessionResult') = 1",
              "",
              "VAR _Position =",
              "    SELECTEDVALUE('dw FactSessionResult'[Position])",
              "",
              "VAR _DNF =",
              "    SELECTEDVALUE('dw FactSessionResult'[DNF])",
              "",
              "VAR _DNS =",
              "    SELECTEDVALUE('dw FactSessionResult'[DNS])",
              "",
              "VAR _DSQ =",
              "    SELECTEDVALUE('dw FactSessionResult'[DSQ])",
              "",
              "VAR _Result =",
              "    SWITCH(",
              "        TRUE(),",
              "        _DSQ = TRUE(), \"DSQ\",",
              "        _DNS = TRUE(), \"DNS\",",
              "        _DNF = TRUE(), \"DNF\",",
              "        NOT ISBLANK(_Position), FORMAT(_Position, \"0\"),",
              "        BLANK()",
              "    )",
              "",
              "VAR _SortOrder =",
              "    SWITCH(",
              "        TRUE(),",
              "        _DSQ = TRUE(), 98,",
              "        _DNS = TRUE(), 99,",
              "        _DNF = TRUE(), 97,",
              "        _Position",
              "    )",
              "",
              "RETURN",
              "IF(",
              "    _HasResult && NOT ISBLANK(_Result),",
              "    REPT(UNICHAR(8203), _SortOrder) & _Result",
              ")"
            ],
            "displayFolder": "Session\\Results"
          },
          {
            "name": "Official Session Performance Result",
            "expression": [
              "",
              "VAR _ResultRows =",
              "    COUNTROWS('dw FactSessionResult')",
              "",
              "VAR _SessionTypeKey =",
              "    SELECTEDVALUE('dw DimSession'[SessionTypeKey])",
              "",
              "VAR _SessionType =",
              "    LOOKUPVALUE(",
              "        'dw DimSessionType'[SessionTypeName],",
              "        'dw DimSessionType'[SessionTypeKey],",
              "        _SessionTypeKey",
              "    )",
              "",
              "VAR _Position =",
              "    SELECTEDVALUE('dw FactSessionResult'[Position])",
              "",
              "VAR _DNF =",
              "    SELECTEDVALUE('dw FactSessionResult'[DNF])",
              "",
              "VAR _DNS =",
              "    SELECTEDVALUE('dw FactSessionResult'[DNS])",
              "",
              "VAR _DSQ =",
              "    SELECTEDVALUE('dw FactSessionResult'[DSQ])",
              "",
              "VAR _Duration =",
              "    SELECTEDVALUE('dw FactSessionResult'[DurationSeconds])",
              "",
              "VAR _Q1 =",
              "    SELECTEDVALUE('dw FactSessionResult'[Phase1DurationSeconds])",
              "",
              "VAR _Q2 =",
              "    SELECTEDVALUE('dw FactSessionResult'[Phase2DurationSeconds])",
              "",
              "VAR _Q3 =",
              "    SELECTEDVALUE('dw FactSessionResult'[Phase3DurationSeconds])",
              "",
              "VAR _GapSeconds =",
              "    SELECTEDVALUE('dw FactSessionResult'[GapToLeaderSeconds])",
              "",
              "VAR _GapText =",
              "    SELECTEDVALUE('dw FactSessionResult'[GapToLeaderText])",
              "",
              "VAR _TimeSeconds =",
              "    SWITCH(",
              "        _SessionType,",
              "        \"Practice\", _Duration,",
              "        \"Qualifying\", COALESCE(_Q3, _Q2, _Q1),",
              "        BLANK()",
              "    )",
              "",
              "VAR _TimeLabel =",
              "    IF(",
              "        NOT ISBLANK(_TimeSeconds),",
              "        FORMAT(INT(_TimeSeconds / 60), \"0\")",
              "            & \":\"",
              "            & FORMAT(MOD(_TimeSeconds, 60), \"00.000\")",
              "    )",
              "",
              "RETURN",
              "IF(",
              "    _ResultRows <> 1,",
              "    BLANK(),",
              "    SWITCH(",
              "        TRUE(),",
              "",
              "        _DSQ = TRUE(), \"DSQ\",",
              "        _DNS = TRUE(), \"DNS\",",
              "        _DNF = TRUE(), \"DNF\",",
              "",
              "        _SessionType = \"Race\" && _Position = 1,",
              "            \"Winner\",",
              "",
              "        _SessionType = \"Race\" && NOT ISBLANK(_GapSeconds),",
              "            \"+\" & FORMAT(_GapSeconds, \"0.000\") & \" s\",",
              "",
              "        _SessionType = \"Race\" && NOT ISBLANK(_GapText),",
              "            _GapText,",
              "",
              "        NOT ISBLANK(_TimeLabel),",
              "            _TimeLabel,",
              "",
              "        _SessionType = \"Race\",",
              "            \"No gap data\",",
              "",
              "        \"No time\"",
              "    )",
              ")"
            ],
            "displayFolder": "Session\\Results"
          },
          {
            "name": "Official Session Leader",
            "expression": [
              "",
              "VAR _LeaderDriverKey =",
              "    CALCULATE(",
              "        SELECTEDVALUE(",
              "            'dw FactSessionResult'[DriverKey]",
              "        ),",
              "        REMOVEFILTERS('dw DimDriver'),",
              "        REMOVEFILTERS('dw DimTeam'),",
              "        REMOVEFILTERS('dw DimTeamColour'),",
              "        'dw FactSessionResult'[Position] = 1",
              "    )",
              "",
              "VAR _LeaderName =",
              "    LOOKUPVALUE(",
              "        'dw DimDriver'[FullName],",
              "        'dw DimDriver'[DriverKey],",
              "        _LeaderDriverKey",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        HASONEVALUE('dw DimSession'[SessionKey]),",
              "        COALESCE(",
              "            _LeaderName,",
              "            \"No official result\"",
              "        ),",
              "        BLANK()",
              "    )"
            ],
            "displayFolder": "Session\\Results"
          },
          {
            "name": "Fastest Lap Label",
            "expression": [
              "",
              "VAR _Seconds = [Fastest Lap Time]",
              "RETURN",
              "IF(",
              "    NOT ISBLANK(_Seconds),",
              "    FORMAT(INT(_Seconds / 60), \"0\")",
              "        & \":\"",
              "        & FORMAT(MOD(_Seconds, 60), \"00.000\")",
              ")"
            ],
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Fastest Lap Driver",
            "expression": [
              "",
              "VAR _FastestLap =",
              "    [Fastest Lap Time]",
              "",
              "VAR _DriverKey =",
              "    MAXX(",
              "        TOPN(",
              "            1,",
              "            FILTER(",
              "                'dw FactLap',",
              "                NOT ISBLANK('dw FactLap'[LapDurationSeconds])",
              "                    && 'dw FactLap'[LapDurationSeconds] = _FastestLap",
              "            ),",
              "            'dw FactLap'[LapKey], ASC",
              "        ),",
              "        'dw FactLap'[DriverKey]",
              "    )",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK(_FastestLap)",
              "        && NOT ISBLANK(_DriverKey),",
              "    LOOKUPVALUE(",
              "        'dw DimDriver'[FullName],",
              "        'dw DimDriver'[DriverKey],",
              "        _DriverKey",
              "    )",
              ")"
            ],
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Session Start",
            "expression": [
              "",
              "SELECTEDVALUE('dw DimSession'[DateStart])"
            ],
            "displayFolder": "Session\\Conditions"
          },
          {
            "name": "Session Rainfall Status",
            "expression": [
              "",
              "VAR _WeatherSamples =",
              "    COUNTROWS('dw FactWeather')",
              "",
              "VAR _RainSamples =",
              "    CALCULATE(",
              "        COUNTROWS('dw FactWeather'),",
              "        'dw FactWeather'[Rainfall] = TRUE()",
              "    )",
              "",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(_WeatherSamples), \"No data\",",
              "        _RainSamples > 0, \"Yes\",",
              "        \"No\"",
              "    )"
            ],
            "displayFolder": "Session\\Conditions"
          },
          {
            "name": "Average Lap Time Excl Pit Out Label",
            "expression": [
              "",
              "VAR _Seconds = [Average Lap Time Excl Pit Out]",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(_Seconds),",
              "        FORMAT(INT(_Seconds / 60), \"0\")",
              "            & \":\"",
              "            & FORMAT(MOD(_Seconds, 60), \"00.000\")",
              "    )"
            ],
            "displayFolder": "Laps\\Timing"
          },
          {
            "name": "Latest Weekend Attendance",
            "expression": [
              "",
              "VAR _LatestDate =",
              "    MAXX(",
              "        FILTER(",
              "            CALCULATETABLE(",
              "                'dw DimRaceWeekend',",
              "                REMOVEFILTERS(",
              "                    'dw DimRaceWeekend'[RaceWeekendKey],",
              "                    'dw DimRaceWeekend'[RaceWeekendName],",
              "                    'dw DimRaceWeekend'[RoundNumber],",
              "                    'dw DimRaceWeekend'[DateStart],",
              "                    'dw DimRaceWeekend'[DateEnd]",
              "                )",
              "            ),",
              "            NOT ISBLANK(",
              "                CALCULATE(",
              "                    MAX('dw FactAttendance'[WeekendAttendance])",
              "                )",
              "            )",
              "        ),",
              "        'dw DimRaceWeekend'[DateEnd]",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(_LatestDate),",
              "        CALCULATE(",
              "            MAX('dw FactAttendance'[WeekendAttendance]),",
              "            REMOVEFILTERS(",
              "                'dw DimRaceWeekend'[RaceWeekendKey],",
              "                'dw DimRaceWeekend'[RaceWeekendName],",
              "                'dw DimRaceWeekend'[RoundNumber],",
              "                'dw DimRaceWeekend'[DateStart],",
              "                'dw DimRaceWeekend'[DateEnd]",
              "            ),",
              "            'dw DimRaceWeekend'[DateEnd] = _LatestDate",
              "        )",
              "    )"
            ],
            "displayFolder": "Attendance"
          },
          {
            "name": "Latest Weekend Attendance Label",
            "expression": [
              "",
              "VAR _Attendance =",
              "    [Latest Weekend Attendance]",
              "",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(_Attendance),",
              "        FORMAT(_Attendance, \"#,##0\"),",
              "        \"No data\"",
              "    )"
            ],
            "displayFolder": "Attendance"
          },
          {
            "name": "Pit Stop Count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('dw FactPitStop'),",
              "    NOT ISBLANK('dw FactPitStop'[StopDurationSeconds])",
              ")"
            ],
            "displayFolder": "Pit Stops"
          },
          {
            "name": "Fastest Pit Stop Time",
            "expression": [
              "",
              "CALCULATE(",
              "    MIN('dw FactPitStop'[StopDurationSeconds]),",
              "    NOT ISBLANK('dw FactPitStop'[StopDurationSeconds])",
              ")"
            ],
            "displayFolder": "Pit Stops"
          },
          {
            "name": "Latest Race Winner",
            "expression": [
              "",
              "VAR _WinnerRow =",
              "    TOPN(",
              "        1,",
              "        CALCULATETABLE(",
              "            'dw FactSessionResult',",
              "",
              "            REMOVEFILTERS('dw DimDriver'),",
              "            REMOVEFILTERS('dw DimTeam'),",
              "            REMOVEFILTERS('dw DimTeamColour'),",
              "",
              "            REMOVEFILTERS(",
              "                'dw DimSession'[SessionName],",
              "                'dw DimSession'[SessionKey]",
              "            ),",
              "",
              "            'dw DimSession'[SessionName] = \"Race\",",
              "            'dw FactSessionResult'[Position] = 1",
              "        ),",
              "",
              "        RELATED('dw DimSession'[DateStart]), DESC,",
              "        'dw FactSessionResult'[SessionKey], DESC",
              "    )",
              "",
              "RETURN",
              "    MAXX(",
              "        _WinnerRow,",
              "        RELATED('dw DimDriver'[FullName])",
              "    )"
            ],
            "displayFolder": "Circuit"
          },
          {
            "name": "Circuit Latest Race Fastest Lap",
            "expression": [
              "",
              "VAR _FastestLapRow =",
              "    CALCULATETABLE(",
              "        TOPN(",
              "            1,",
              "            FILTER(",
              "                'dw FactLap',",
              "                NOT ISBLANK(",
              "                    'dw FactLap'[LapDurationSeconds]",
              "                )",
              "            ),",
              "            RELATED('dw DimSession'[DateStart]), DESC,",
              "            'dw FactLap'[LapDurationSeconds], ASC,",
              "            'dw FactLap'[LapKey], ASC",
              "        ),",
              "",
              "        REMOVEFILTERS(",
              "            'dw DimRaceWeekend'[RaceWeekendKey],",
              "            'dw DimRaceWeekend'[RaceWeekendName],",
              "            'dw DimRaceWeekend'[RoundNumber],",
              "            'dw DimRaceWeekend'[DateStart],",
              "            'dw DimRaceWeekend'[DateEnd]",
              "        ),",
              "",
              "        REMOVEFILTERS(",
              "            'dw DimSession'[SessionKey],",
              "            'dw DimSession'[SessionName]",
              "        ),",
              "",
              "        'dw DimSession'[SessionName] = \"Race\",",
              "",
              "        REMOVEFILTERS('dw DimDriver'),",
              "        REMOVEFILTERS('dw DimTeam'),",
              "        REMOVEFILTERS('dw DimTeamColour')",
              "    )",
              "",
              "RETURN",
              "    MINX(",
              "        _FastestLapRow,",
              "        'dw FactLap'[LapDurationSeconds]",
              "    )"
            ],
            "displayFolder": "Circuit"
          },
          {
            "name": "Circuit Latest Race Fastest Lap Driver",
            "expression": [
              "",
              "VAR _FastestLapRow =",
              "    CALCULATETABLE(",
              "        TOPN(",
              "            1,",
              "            FILTER(",
              "                'dw FactLap',",
              "                NOT ISBLANK(",
              "                    'dw FactLap'[LapDurationSeconds]",
              "                )",
              "            ),",
              "            RELATED('dw DimSession'[DateStart]), DESC,",
              "            'dw FactLap'[LapDurationSeconds], ASC,",
              "            'dw FactLap'[LapKey], ASC",
              "        ),",
              "",
              "        REMOVEFILTERS(",
              "            'dw DimRaceWeekend'[RaceWeekendKey],",
              "            'dw DimRaceWeekend'[RaceWeekendName],",
              "            'dw DimRaceWeekend'[RoundNumber],",
              "            'dw DimRaceWeekend'[DateStart],",
              "            'dw DimRaceWeekend'[DateEnd]",
              "        ),",
              "",
              "        REMOVEFILTERS(",
              "            'dw DimSession'[SessionKey],",
              "            'dw DimSession'[SessionName]",
              "        ),",
              "",
              "        'dw DimSession'[SessionName] = \"Race\",",
              "",
              "        REMOVEFILTERS('dw DimDriver'),",
              "        REMOVEFILTERS('dw DimTeam'),",
              "        REMOVEFILTERS('dw DimTeamColour')",
              "    )",
              "",
              "VAR _DriverKey =",
              "    MAXX(",
              "        _FastestLapRow,",
              "        'dw FactLap'[DriverKey]",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(_DriverKey),",
              "        LOOKUPVALUE(",
              "            'dw DimDriver'[FullName],",
              "            'dw DimDriver'[DriverKey],",
              "            _DriverKey",
              "        )",
              "    )"
            ],
            "displayFolder": "Circuit"
          },
          {
            "name": "Circuit Latest Race Fastest Lap Label",
            "expression": [
              "",
              "VAR _Seconds =",
              "    [Circuit Latest Race Fastest Lap]",
              "",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(_Seconds),",
              "        FORMAT(INT(_Seconds / 60), \"0\")",
              "            & \":\"",
              "            & FORMAT(",
              "                MOD(_Seconds, 60),",
              "                \"00.000\",",
              "                \"en-US\"",
              "            ),",
              "        \"No data\"",
              "    )"
            ],
            "displayFolder": "Circuit"
          },
          {
            "name": "Circuit Calendar Sort Order",
            "expression": [
              "",
              "VAR _LatestSeason =",
              "    CALCULATE(",
              "        MAX('dw DimRaceWeekend'[SeasonKey]),",
              "        REMOVEFILTERS('dw DimCircuit')",
              "    )",
              "RETURN",
              "    CALCULATE(",
              "        MIN('dw DimRaceWeekend'[RoundNumber]),",
              "        'dw DimRaceWeekend'[SeasonKey] = _LatestSeason",
              "    )"
            ],
            "displayFolder": "Circuit"
          },
          {
            "name": "Circuit Has Weekend",
            "expression": [
              "",
              "IF(",
              "    COUNTROWS('dw DimRaceWeekend') > 0,",
              "    1,",
              "    0",
              ")"
            ],
            "displayFolder": "Circuit"
          },
          {
            "name": "Official Session Leader Headshot URL",
            "expression": [
              "",
              "VAR _HasOneSession =",
              "    HASONEVALUE('dw DimSession'[SessionKey])",
              "",
              "VAR _WinnerDriverKey =",
              "    CALCULATE(",
              "        MAX('dw FactSessionResult'[DriverKey]),",
              "        'dw FactSessionResult'[Position] = 1",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        NOT _HasOneSession,",
              "        BLANK(),",
              "        CALCULATE(",
              "            MAX('dw DimDriver'[HeadshotUrl]),",
              "            FILTER(",
              "                ALL('dw DimDriver'),",
              "                'dw DimDriver'[DriverKey] = _WinnerDriverKey",
              "            )",
              "        )",
              "    )"
            ],
            "displayFolder": "Session\\Results"
          }
        ]
      },
